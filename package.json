{
  "name": "@afilimax/cli",
  "description": "CLI para geração de links de afiliados: Amazon, Mercado Livre, Magazine Luiza, Shopee e AliExpress",
  "version": "0.2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Afilimax/afilimax-cli.git"
  },
  "homepage": "https://github.com/Afilimax/afilimax-cli#readme",
  "bugs": {
    "url": "https://github.com/Afilimax/afilimax-cli/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*bundle*.js",
    "!/**/__tests__"
  ],
  "bin": {
    "afilimax": "dist/afilimax.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/afilimax.ts --bundle --platform=node --target=node22 --outfile=dist/afilimax-bundle.js --packages=external",
    "build:bin": "pkg dist/afilimax-bundle.js --targets node22-win-x64,node22-linux-x64,node22-macos-x64 --out-path bin && node -e \"const fs=require('fs'); if(fs.existsSync('bin/afilimax-bundle-win.exe')) fs.renameSync('bin/afilimax-bundle-win.exe','bin/afilimax-win.exe'); if(fs.existsSync('bin/afilimax-bundle-linux')) fs.renameSync('bin/afilimax-bundle-linux','bin/afilimax-linux'); if(fs.existsSync('bin/afilimax-bundle-macos')) fs.renameSync('bin/afilimax-bundle-macos','bin/afilimax-macos');\"",
    "build:all": "npm run build && npm run build:bundle && npm run build:bin",
    "prepublishOnly": "npm run build",
    "dev": "tsx ./src/afilimax.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "afilimax",
    "affiliate",
    "amazon",
    "mercado-livre",
    "shopee",
    "aliexpress",
    "cli"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.4.0",
    "@types/readline-sync": "^1.4.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "pkg": "^5.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@afilimax/aliexpress-provider": "^0.2.0",
    "@afilimax/aliexpress-scraper": "^0.2.0",
    "@afilimax/amazon-browser-provider": "^0.2.2",
    "@afilimax/amazon-scraper": "^0.2.1",
    "@afilimax/core": "^0.5.0",
    "@afilimax/magazine-luiza-provider": "^0.1.0",
    "@afilimax/mercado-livre-provider": "^0.2.1",
    "@afilimax/mercado-livre-scraper": "^0.2.1",
    "@afilimax/shopee-provider": "^0.1.0",
    "@mihnea.dev/puppeteer-extra-amazon-captcha": "^1.0.3",
    "@xcrap/core": "^0.2.3",
    "@xcrap/extractor": "^0.3.2",
    "@xcrap/got-scraping-client": "^0.1.1",
    "@xcrap/puppeteer-client": "^0.1.0",
    "@xcrap/puppeteer-extra-client": "^0.1.0",
    "@xcrap/transformer": "^0.3.7",
    "commander": "^15.0.0",
    "impit": "^0.14.6",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "readline-sync": "^1.4.10",
    "winston": "^3.19.0"
  }
}
